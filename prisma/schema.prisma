// Thrivie data model.
// - Multi-user: every record belongs to exactly one User (directly via userId,
//   or through its parent for Exercise / HabitCheckin / GoalProgress). All app
//   queries go through a per-user scoped client (src/lib/db.ts), so one user's
//   data is never visible to another.
// - Dates are "YYYY-MM-DD" strings in the user's timezone (Settings.timezone).
// - Measurements are stored metric (kg, km, ml) and converted for display.
// - Postgres. Row Level Security is enabled and FORCED on every table (see
//   prisma/migrations/*_rls): the app runs each query as the restricted role
//   "thrivie_rls" with the user id set for that transaction, so the database
//   itself refuses to return or change another user's rows.
// - Journal text, notes and attachments are encrypted (AES-256-GCM) before
//   they reach the database (src/lib/crypto.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // pooled connection (set automatically by Vercel → Storage → Neon)
  directUrl = env("POSTGRES_URL_NON_POOLING") // direct connection for migrations (also set automatically)
}

// ---------------------------------------------------------------- accounts --

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  // Two-factor authentication (TOTP). Secret is encrypted; recovery codes are hashed.
  totpSecret     String?
  totpEnabled    Boolean  @default(false)
  recoveryCodes  String? // JSON array of sha256 hashes
  createdAt      DateTime @default(now())

  aliases       Alias[]
  sessions      Session[]
  settings      Settings?
  healthLogs    HealthLog[]
  workouts      Workout[]
  habits        Habit[]
  goals         Goal[]
  journal       JournalEntry[]
  meals         Meal[]
  bodyProfile   BodyProfile?
  mealPlans     MealPlan[]
  attachments   Attachment[]
  pushSubs      PushSubscription[]
  apiTokens     ApiToken[]
}

model Session {
  id          String   @id // sha256 of the cookie token (the raw token is never stored)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaVerified Boolean  @default(false) // false until the 2FA code is entered (when 2FA is on)
  expiresAt   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Rate-limit events (login failures, writes, magic-link requests). Keys are hashed.
model RateEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// One-time sign-in links. Only the token hash is stored.
model MagicLink {
  id        String    @id // sha256 of the token
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Settings {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String   @default("")
  units          String   @default("imperial") // imperial (U.S.) | metric
  timezone       String   @default("America/New_York")
  visibleModules String   @default("health,workouts,nutrition,habits,goals,journal")
  // Reminders (web push)
  remindersOn    Boolean  @default(false)
  reminderHour   Int      @default(20) // local hour 0-23
  lastReminded   String? // YYYY-MM-DD of the last reminder sent
  onboarded      Boolean  @default(false)
  tipsSeen       String   @default("") // comma-separated tip ids already shown
  onDeviceAi     Boolean  @default(false)
  // Optional daily nutrition targets (never set by default).
  calorieTarget  Int?
  proteinTargetG Int?
  hideCalories   Boolean  @default(false) // meal plans show portions, not numbers
  updatedAt      DateTime @updatedAt
}

// ------------------------------------------------------------------ health --

model HealthLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String
  weightKg     Float?
  sleepHours   Float?
  sleepQuality Int? // 1-5
  waterMl      Int?
  mood         Int? // 1-5
  energy       Int? // 1-5
  steps        Int?
  custom       String? // JSON object: { "Resting HR": 58 }
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
}

model Workout {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  type        String // strength | cardio | mobility | sport | other
  title       String?
  durationMin Int
  intensity   Int        @default(3) // 1-5
  distanceKm  Float?
  paceMinKm   Float? // minutes per km
  notes       String?
  source      String? // e.g. "apple-health" when synced
  exercises   Exercise[]
  createdAt   DateTime   @default(now())

  @@index([userId, date])
}

model Exercise {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  sets      Int?
  reps      Int?
  weightKg  Float?
  order     Int     @default(0)
}

// --------------------------------------------------------------- nutrition --

/// A meal or snack. Name and notes are encrypted; every number is optional.
model Meal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  slot      String // breakfast | lunch | dinner | snack
  name      String
  calories  Int?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

/// Body & Goals profile: height, weight, age, sex, pregnancy, activity, goal,
/// diet and allergies, stored as one AES-256-GCM encrypted JSON blob.
model BodyProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String // encrypted JSON (src/lib/nutrition/calculations.ts BodyProfileSchema)
  updatedAt DateTime @updatedAt
}

/// A week's meal plan (meal ids and swaps). Encrypted because it can reveal diet and allergies.
model MealPlan {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   String // YYYY-MM-DD (Monday)
  data        String // encrypted JSON
  profileHash String // regenerate when the profile or targets change
  createdAt   DateTime @default(now())

  @@id([userId, weekStart])
}

// ------------------------------------------------------------------ habits --

model Habit {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  emoji        String?
  // {"type":"daily"} | {"type":"specific_days","days":[1,3,5]} | {"type":"times_per_period","count":3,"period":"week"}
  // Validated by src/lib/habits/schedule.ts and a CHECK constraint (thrivie_valid_schedule).
  schedule     Json           @default("{\"type\":\"daily\"}")
  archived     Boolean        @default(false)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  checkins     HabitCheckin[]
  goals        Goal[]

  @@index([userId])
}

model HabitCheckin {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    String
  count   Int    @default(1) // > 1 only for "N times a day" habits (1-100)

  @@unique([habitId, date])
  @@index([date])
}

// ------------------------------------------------------------------- goals --

model Goal {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  target          Float
  unit            String
  startDate       String
  deadline        String
  startValue      Float?
  // manual | metric | workout | habit (see README)
  linkType        String         @default("manual")
  linkMetric      String?
  linkWorkoutType String?
  linkMeasure     String?
  linkHabitId     String?
  habit           Habit?         @relation(fields: [linkHabitId], references: [id], onDelete: SetNull)
  archived        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  progress        GoalProgress[]

  @@index([userId])
}

model GoalProgress {
  id     String  @id @default(cuid())
  goalId String
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date   String
  value  Float
  note   String?

  @@index([goalId, date])
}

// ----------------------------------------------------------------- journal --

model JournalEntry {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  content     String
  mood        Int? // 1-5
  prompt      String?
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, date])
}

/// Photos and voice notes attached to journal entries (stored in the DB so
/// hosting needs no separate file storage; photos are resized on the device).
model Attachment {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalId String?
  journal   JournalEntry? @relation(fields: [journalId], references: [id], onDelete: Cascade)
  kind      String // photo | audio
  mime      String
  size      Int
  durationS Float?
  data      Bytes // AES-256-GCM encrypted
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([journalId])
}

// ----------------------------------------------------------- smart import --

/// Personal shorthand learned from import corrections, e.g. "bb" → "Bench press".
model Alias {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // exercise | habit | workout | metric
  alias     String
  target    String
  createdAt DateTime @default(now())

  @@unique([userId, kind, alias])
}

// ------------------------------------------------- reminders & integrations --

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Personal access tokens for the health-sync endpoint (Apple Shortcuts etc.).
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique // sha256 of the token
  prefix     String // first characters, shown in the UI
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Server-wide settings generated at runtime (e.g. push keys when not set in env).
model AppConfig {
  key   String @id
  value String
}
