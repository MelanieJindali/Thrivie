# ------------------------------------------------------------------ database --
# Postgres. On Vercel these two are created automatically when you add a
# Neon database under Project → Storage. Locally, point both at your Postgres.
# POSTGRES_PRISMA_URL:      pooled connection used by the app
# POSTGRES_URL_NON_POOLING: direct connection used for migrations during the build
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/thrivie"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/thrivie"

# ---------------------------------------------------------------- security ---
# 32 random bytes, base64. Generate at /setup in the running app, or:
#   npm run gen:key
# Required in production. Keep a safe copy: encrypted data can't be read without it.
ENCRYPTION_KEY=""
# Optional, for key rotation: the previous key, still accepted for reading.
ENCRYPTION_KEY_PREVIOUS=""

# ---------------------------------------------------------------- accounts ---
# Strongly recommended on a public URL: people need this code to sign up.
SIGNUP_CODE=""
# Set to "false" to close sign-ups entirely (existing users can still sign in).
ALLOW_SIGNUP="true"

# Optional: email sign-in links via Resend (free tier).
RESEND_API_KEY=""
EMAIL_FROM="Thrivie <hello@your-domain.com>"
APP_URL="https://your-app.vercel.app"

# --------------------------------------------------------------- reminders ---
# Any long random string; your hourly scheduler sends it to /api/cron/reminders.
CRON_SECRET=""
# Optional: push keys are generated automatically and stored if left empty.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
