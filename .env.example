# ---------------------------------------------------------------- database --
# Local / self-hosted: a SQLite file (relative to prisma/)
DATABASE_URL="file:./thrivie.db"
# Free hosted database (Turso). When set, these are used instead of DATABASE_URL.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ---------------------------------------------------------------- accounts --
# Strongly recommended on a public URL: people need this code to sign up.
SIGNUP_CODE=""
# Set to "false" to close sign-ups entirely (existing users can still sign in).
ALLOW_SIGNUP="true"

# ---------------------------------------------------------------------- AI --
# Needed only for AI Notes Import, the daily brief, highlights and weekly review.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# --------------------------------------------------------------- reminders --
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Any long random string; your scheduler sends it to /api/cron/reminders.
CRON_SECRET=""
