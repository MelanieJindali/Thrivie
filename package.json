{
  "name": "thrivie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:new-migration": "prisma migrate dev --create-only",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.87",
    "@prisma/client": "^6.19.3",
    "chrono-node": "^2.10.3",
    "dotenv": "^18.0.9",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.70.0",
    "next": "^15.5.29",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "lighthouse": "^13.6.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.0"
  }
}
