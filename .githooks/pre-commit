#!/usr/bin/env sh
# Blocks commits containing secrets or sensitive files.
# Enabled automatically by `npm install` (scripts/install-hooks.mjs), or by hand:
#   git config core.hooksPath .githooks
staged=$(git diff --cached --name-only --diff-filter=ACM)

for f in $staged; do
  case "$f" in
    .env.example) ;;
    .env|.env.*|*/.env|*/.env.*|*.pem|*.key|*.pfx|*.p12|*id_rsa*|*credentials.json|*.log)
      echo "BLOCKED: sensitive file staged: $f"; exit 1 ;;
  esac
done

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner -v || { echo "BLOCKED: gitleaks found a secret."; exit 1; }
else
  # Added lines only, skipping this file (its patterns would match themselves).
  # Obvious placeholders such as postgresql://USER:PASSWORD@HOST are allowed.
  if git diff --cached -U0 -- . ':(exclude).githooks/pre-commit' | grep -E '^\+' | grep -vE '://(USER|user|<user>|username):(PASSWORD|password|<password>)@' | grep -qE \
    '(sk-[A-Za-z0-9_-]{20,}|sk_live_[A-Za-z0-9]{16,}|rk_live_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|npm_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----|eyJhbGciOi[A-Za-z0-9_-]{20,}|postgres(ql)?://[^:]+:[^@]+@|mysql://[^:]+:[^@]+@|mongodb(\+srv)?://[^:]+:[^@]+@|redis://[^:]*:[^@]+@)'; then
    echo "BLOCKED: possible secret in staged changes. Install gitleaks for a full scan."; exit 1
  fi
fi
exit 0
